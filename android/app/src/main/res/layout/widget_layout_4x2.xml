<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_4x2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Bức ảnh do Flutter render -->
    <ImageView
        android:id="@+id/widget_image_4x2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="VIE Lịch Widget 4x2" />

    <!-- Lớp phủ trong suốt để bắt sự kiện chạm -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="100">

        <!-- Vùng chạm bên trái (Vạn niên) - Chiếm 42% -->
        <LinearLayout
            android:id="@+id/left_click_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="42"
            android:clickable="true"
            android:focusable="true" />

        <!-- Vùng chạm bên phải & khoảng trống (Lịch tháng) - Chiếm 58% -->
        <LinearLayout
            android:id="@+id/right_click_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="58"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</RelativeLayout>